# Runtime
PORT=3000
APP_BASE_URL=https://cogniva-compass.webflow.io
SERVICE_BASE_URL=https://cogniva-compass-production.up.railway.app

# PostgreSQL. Railway supplies this only after a PostgreSQL service is linked.
# Use a Railway variable reference; never copy the value into Git or Webflow.
DATABASE_URL=
DATABASE_SSL=false

# Stripe Checkout. These credentials come from the Stripe account, not Railway.
# Store test values in the test service and live values only in the live service.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SINGLE_PRICE_ID=
STRIPE_BUNDLE_PRICE_ID=
STRIPE_AUTOMATIC_TAX=false
STRIPE_INVOICE_CREATION=false

# Server-owned product contract. single_v1 is USD 7.99 and bundle_v1 is USD
# 12.99. Both Stripe Prices must be active, fixed, tax-inclusive and one-time.
# Amount, currency and Price ID are never accepted from the browser.

# Resend. These values come from the Resend account after domain verification;
# Railway only stores them as encrypted application-service Variables.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Optional OpenAI narrative. Keep disabled unless vendor/privacy review and explicit
# user choice are in place. A deterministic report remains available without it.
OPENAI_REPORT_ENABLED=false
OPENAI_API_KEY=
OPENAI_REPORT_MODEL=

# Legal readiness. All templates in docs/ remain drafts until the placeholders,
# translations, document hashes and professional approvals are complete.
PRIVACY_URL=
TERMS_URL=
CONTACT_URL=
POLICY_VERSION=2026-07-26-draft
PRIVACY_VERSION=2026-07-31-draft
TERMS_VERSION=2026-07-31-draft
LEGAL_CONTENT_VERSION=2026-07-31-draft-v1
PRIVACY_DOCUMENT_SHA256=
TERMS_DOCUMENT_SHA256=
LEGAL_CONSENT_SECRET=

# Controller/trader identity and rights/support contacts. Do not enable paid
# checkout with placeholders or unreviewed values.
CONTROLLER_LEGAL_NAME=
REGISTERED_ADDRESS=
CONTROLLER_COUNTRY=
REGISTRATION_NO=
TAX_NO=
PRIVACY_EMAIL=
SUPPORT_EMAIL=
DPO_EMAIL=
SUPERVISORY_AUTHORITY_NAME=
SUPERVISORY_AUTHORITY_URL=

# Optional server-to-server NeuroMap dashboard gateway. Generate a random secret
# of at least 32 bytes and store the same secret only in the two Railway backend
# services. It must never be present in Webflow or any browser response.
COGNIVA_ADMIN_INTEGRATION_KEY_ID=cogniva-dashboard-v1
COGNIVA_ADMIN_INTEGRATION_SECRET=
COGNIVA_ADMIN_CLOCK_SKEW_SECONDS=60

# Operations. The application clamps these to its documented safe ranges.
REPORT_RETENTION_DAYS=30
MAX_REPORT_ATTEMPTS=5
REPORT_WORKER_INTERVAL_MS=5000
